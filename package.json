    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingmingxi/dsh-plugin-subitem-status.git"
  },
  "homepage": "https://github.com/lingmingxi/dsh-plugin-subitem-status#readme",
  "bugs": {
    "url": "https://github.com/lingmingxi/dsh-plugin-subitem-status/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
